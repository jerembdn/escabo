// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum QueueType {
  // TFT
  ranked_tft
  ranked_tft_double_up

  // LOL
  ranked_solo_5x5
  ranked_flex_sr
}

enum RankedTier {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  EMERALD
  MASTER
  GRANDMASTER
  CHALLENGER
}

enum RankedDivision {
  I
  II
  III
  IV
}

enum RegionId {
  EUW
}

model SummonerLeagueEntity {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  leagueId     String
  queueType    QueueType
  tier         RankedTier
  rank         RankedDivision?
  wins         Int
  losses       Int
  leaguePoints Int

  // Relation to Summoner
  summoner   SummonerEntity @relation(fields: [summonerId], references: [id])
  summonerId String         @db.ObjectId

  @@unique([summonerId, queueType])
}

model SummonerEntity {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  puuid         String   @unique
  summonerId    String   @unique
  accountId     String   @unique
  profileIconId Int
  level         Int
  region        RegionId

  // Relation to SummonerLeague
  leagues SummonerLeagueEntity[]

  @@index([name])
}
