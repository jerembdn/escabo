    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.6.8",
    "@vercel/speed-insights": "^1.2.0",
    "kitchn": "latest",
    "lucide-react": "^0.488.0",
    "next": "^14.0.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.5.0",
